# BunkerWeb — configuration globale, exemple sanitisé.
# À placer à côté du compose, en 600. Aucun secret ici : les tokens passent
# par le fichier .env du compose ou un gestionnaire de secrets.
#
# MULTISITE=yes exige un SERVER_NAME explicite : BunkerWeb n'accepte pas
# les wildcards (*.example.com) dans cette liste. Un Host absent retombe
# sur le vhost par défaut.
#
# La liste réelle est générée depuis les vhosts nginx, puis relue à la main.
# Ici : extrait représentatif, volontairement court.

# Attention : un env_file Docker ne gère pas les continuations "\".
# SERVER_NAME doit tenir sur UNE seule ligne.
MULTISITE=yes
SERVER_NAME=sitecreator.shop www.sitecreator.shop cogtopia.events www.cogtopia.events help.cogtopia.events support.sitecreator.shop beta.sitecreator.shop client-a.sitecreator.shop client-b.sitecreator.shop lab.example.com www.lab.example.com cours.lab.example.com hackaton.lab.example.com admin.hackaton.lab.example.com checkmk.example.com diagrams.example.com freellm.example.com

# --- Reverse proxy vers Caddy (TLS interne) ---
USE_REVERSE_PROXY=yes
REVERSE_PROXY_URL=/
REVERSE_PROXY_HOST=https://10.20.30.156
# Le Host d'origine est conservé : Caddy route par hostname.
REVERSE_PROXY_HEADERS=Host $host
# n8n, OpenProject, draw.io, ttyd
REVERSE_PROXY_WS=yes
# Laisser passer les 401/403/404 de l'application (Basic Auth, API).
REVERSE_PROXY_INTERCEPT_ERRORS=no
# Phase 1 : le hop est chiffré, la chaîne n'est pas encore vérifiée.
# Phase 2 : passer à yes après validation de la root et de la profondeur.
REVERSE_PROXY_SSL_VERIFY=no

# --- Mode sécurité ---
# detection : on logue sans bloquer (tuning)
# block     : on bloque (état cible)
SECURITY_MODE=block

# --- IP réelle derrière cloudflared ---
USE_REAL_IP=yes
# Liste de confiance : UNIQUEMENT les connecteurs. Toute IP ajoutée ici
# peut falsifier CF-Connecting-IP (rate limit, logs, bannissements).
REAL_IP_FROM=22.22.22.20 10.20.30.40
REAL_IP_HEADER=CF-Connecting-IP

# --- Compression et WAF ---
USE_GZIP=yes
USE_BROTLI=yes
USE_MODSECURITY=yes
USE_MODSECURITY_GLOBAL_CRS=yes
# Les 401 Basic Auth sont comptés comme du "bad behavior" : faux positifs.
USE_BAD_BEHAVIOR=no
USE_LIMIT_REQ=yes
LIMIT_REQ_RATE=20r/s
USE_ANTIBOT=no

# --- TLS public terminé par Cloudflare ---
AUTO_LETS_ENCRYPT=no
MAX_CLIENT_SIZE=50m
